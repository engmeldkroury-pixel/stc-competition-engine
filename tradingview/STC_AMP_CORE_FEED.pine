//@version=6
indicator("STC AMP Core Feed A v0.4 A+ 1H Confirm", overlay=true, max_labels_count=20)

competitionId = input.string("amp-futures-sep-2026", "Competition ID", options=["amp-futures-sep-2026"], group="Production feed")
feedTf = input.timeframe("15", "Production feed timeframe", group="Production feed")
confirmTf = input.timeframe("60", "A+ confirmation timeframe", options=["60"], group="Production feed")
feedEnabled = input.bool(true, "Enable webhook feed", group="Production feed")

// Visual analysis for the symbol currently open on the chart.
// These visuals are decision support only; the backend locked_trade_plan remains authoritative.
showZones = input.bool(true, "Show entry / stop / exit zones", group="Visual analysis")
showEMAs = input.bool(true, "Show EMA 20 / 50 / 200", group="Visual analysis")
showStructure = input.bool(false, "Show dynamic support / resistance", group="Visual analysis")
showBiasBackground = input.bool(false, "Shade chart by live directional bias", group="Visual analysis")
showDashboard = input.bool(true, "Show setup dashboard", group="Visual analysis")
showCurrentSetupLabel = input.bool(true, "Show current locked setup label", group="Visual analysis")
showHistoricalSetupLabels = input.bool(false, "Show historical LONG/SHORT labels", group="Visual analysis")
structureLen = input.int(34, "Structure lookback bars", minval=10, maxval=200, group="Visual analysis")
htfMultiplier = input.float(4.0, "Higher-timeframe multiplier", minval=2.0, maxval=12.0, step=1.0, group="Visual analysis")
setupThreshold = input.float(0.50, "Setup threshold", minval=0.20, maxval=0.90, step=0.05, group="Visual analysis")
entryHalfWidthAtr = input.float(0.25, "Entry zone half-width (ATR)", minval=0.10, maxval=1.00, step=0.05, group="Visual analysis")
stopAtr = input.float(0.90, "Minimum stop distance (ATR)", minval=0.50, maxval=3.00, step=0.10, group="Visual analysis")
target1R = input.float(1.50, "Target 1 reward/risk", minval=0.50, maxval=5.00, step=0.25, group="Visual analysis")
target2R = input.float(2.50, "Target 2 reward/risk", minval=1.00, maxval=8.00, step=0.25, group="Visual analysis")
setupLifetimeBars = input.int(4, "Locked setup lifetime (bars)", minval=1, maxval=50, group="Visual analysis")

type FeedBar
    int t
    float o
    float h
    float l
    float c
    float v
    float ema20
    float ema50
    float rsi14
    float atr14
    float macd
    float macdSignal
    float volumeRatio

type ConfirmBar
    int t
    float c
    float ema20
    float ema50
    float ema200
    float rsi14
    float atr14
    float macd
    float macdSignal
    float volumeRatio

type HistoryBar
    int t
    float c
    float ema50
    float ema200
    float rsi14
    float atr14
    float high252
    float low252
    float momentum20
    float momentum63
    float momentum126
    float momentum252
    float volatility20

makeFeedBar() =>
    [macdLine, signalLine, _] = ta.macd(close, 12, 26, 9)
    volSma = ta.sma(volume, 20)
    FeedBar.new(time, open, high, low, close, volume, ta.ema(close, 20), ta.ema(close, 50), ta.rsi(close, 14), ta.atr(14), macdLine, signalLine, not na(volume) and volSma > 0 ? volume / volSma : 1.0)

feedBar(string symbol) =>
    request.security(symbol, feedTf, makeFeedBar(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=false)

makeConfirmBar() =>
    [macdLine, signalLine, _] = ta.macd(close, 12, 26, 9)
    volSma = ta.sma(volume, 20)
    ConfirmBar.new(time[1], close[1], ta.ema(close, 20)[1], ta.ema(close, 50)[1], ta.ema(close, 200)[1], ta.rsi(close, 14)[1], ta.atr(14)[1], macdLine[1], signalLine[1], not na(volume[1]) and volSma[1] > 0 ? volume[1] / volSma[1] : 1.0)

confirmBar(string symbol) =>
    request.security(symbol, confirmTf, makeConfirmBar(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on, ignore_invalid_symbol=false)

makeHistoryBar() =>
    m20 = close[21] != 0 ? close[1] / close[21] - 1.0 : 0.0
    m63 = close[64] != 0 ? close[1] / close[64] - 1.0 : 0.0
    m126 = close[127] != 0 ? close[1] / close[127] - 1.0 : 0.0
    m252 = close[253] != 0 ? close[1] / close[253] - 1.0 : 0.0
    vol20 = close[1] != 0 ? ta.atr(20)[1] / close[1] : 0.0
    HistoryBar.new(time[1], close[1], ta.ema(close, 50)[1], ta.ema(close, 200)[1], ta.rsi(close, 14)[1], ta.atr(14)[1], ta.highest(high, 252)[1], ta.lowest(low, 252)[1], m20, m63, m126, m252, vol20)

historyBar(string symbol) =>
    request.security(symbol, "1D", makeHistoryBar(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on, ignore_invalid_symbol=false)

buildMessage(string symbol, FeedBar d, ConfirmBar q, HistoryBar h) =>
    eventId = competitionId + "|" + symbol + "|" + feedTf + "|" + str.tostring(d.t)
    msg = (
        '{"event_id":"' + eventId + '",' +
        '"event":"bar_close",' +
        '"competition_id":"' + competitionId + '",' +
        '"symbol":"' + symbol + '",' +
        '"timeframe":"' + feedTf + '",' +
        '"time":"' + str.format_time(d.t, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + '",' +
        '"open":' + str.tostring(d.o) + ',' +
        '"high":' + str.tostring(d.h) + ',' +
        '"low":' + str.tostring(d.l) + ',' +
        '"close":' + str.tostring(d.c) + ',' +
        '"volume":' + str.tostring(d.v) + ',' +
        '"ema20":' + str.tostring(d.ema20) + ',' +
        '"ema50":' + str.tostring(d.ema50) + ',' +
        '"rsi14":' + str.tostring(d.rsi14) + ',' +
        '"atr14":' + str.tostring(d.atr14) + ',' +
        '"macd":' + str.tostring(d.macd) + ',' +
        '"macd_signal":' + str.tostring(d.macdSignal) + ',' +
        '"volume_ratio":' + str.tostring(d.volumeRatio) + ',' +
        '"confirm_timeframe":"' + confirmTf + '",' +
        '"confirm_time":"' + str.format_time(q.t, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + '",' +
        '"confirm_close":' + str.tostring(q.c) + ',' +
        '"confirm_ema20":' + str.tostring(q.ema20) + ',' +
        '"confirm_ema50":' + str.tostring(q.ema50) + ',' +
        '"confirm_ema200":' + str.tostring(q.ema200) + ',' +
        '"confirm_rsi14":' + str.tostring(q.rsi14) + ',' +
        '"confirm_atr14":' + str.tostring(q.atr14) + ',' +
        '"confirm_macd":' + str.tostring(q.macd) + ',' +
        '"confirm_macd_signal":' + str.tostring(q.macdSignal) + ',' +
        '"confirm_volume_ratio":' + str.tostring(q.volumeRatio) + ',' +
        '"history_timeframe":"1D",' +
        '"history_time":"' + str.format_time(h.t, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + '",' +
        '"history_close":' + str.tostring(h.c) + ',' +
        '"history_ema50":' + str.tostring(h.ema50) + ',' +
        '"history_ema200":' + str.tostring(h.ema200) + ',' +
        '"history_rsi14":' + str.tostring(h.rsi14) + ',' +
        '"history_atr14":' + str.tostring(h.atr14) + ',' +
        '"history_high_252":' + str.tostring(h.high252) + ',' +
        '"history_low_252":' + str.tostring(h.low252) + ',' +
        '"history_momentum_20":' + str.tostring(h.momentum20) + ',' +
        '"history_momentum_63":' + str.tostring(h.momentum63) + ',' +
        '"history_momentum_126":' + str.tostring(h.momentum126) + ',' +
        '"history_momentum_252":' + str.tostring(h.momentum252) + ',' +
        '"history_volatility_20":' + str.tostring(h.volatility20) +
        '}'
    )
    msg

mes = feedBar("CME_MINI:MES1!")
mesC = confirmBar("CME_MINI:MES1!")
mesH = historyBar("CME_MINI:MES1!")
mnq = feedBar("CME_MINI:MNQ1!")
mnqC = confirmBar("CME_MINI:MNQ1!")
mnqH = historyBar("CME_MINI:MNQ1!")
mym = feedBar("CBOT_MINI:MYM1!")
mymC = confirmBar("CBOT_MINI:MYM1!")
mymH = historyBar("CBOT_MINI:MYM1!")
m2k = feedBar("CME_MINI:M2K1!")
m2kC = confirmBar("CME_MINI:M2K1!")
m2kH = historyBar("CME_MINI:M2K1!")
mcl = feedBar("NYMEX:MCL1!")
mclC = confirmBar("NYMEX:MCL1!")
mclH = historyBar("NYMEX:MCL1!")
mng = feedBar("NYMEX:MNG1!")
mngC = confirmBar("NYMEX:MNG1!")
mngH = historyBar("NYMEX:MNG1!")
mgc = feedBar("COMEX_MINI:MGC1!")
mgcC = confirmBar("COMEX_MINI:MGC1!")
mgcH = historyBar("COMEX_MINI:MGC1!")
sil = feedBar("COMEX_MINI:SIL1!")
silC = confirmBar("COMEX_MINI:SIL1!")
silH = historyBar("COMEX_MINI:SIL1!")
varip int lastMES = na
varip int lastMNQ = na
varip int lastMYM = na
varip int lastM2K = na
varip int lastMCL = na
varip int lastMNG = na
varip int lastMGC = na
varip int lastSIL = na


if feedEnabled and barstate.isconfirmed and barstate.isrealtime
    if not na(mes.t) and not na(mes.c) and (na(lastMES) or mes.t != lastMES)
        lastMES := mes.t
        alert(buildMessage("CME_MINI:MES1!", mes, mesC, mesH), alert.freq_all)
    if not na(mnq.t) and not na(mnq.c) and (na(lastMNQ) or mnq.t != lastMNQ)
        lastMNQ := mnq.t
        alert(buildMessage("CME_MINI:MNQ1!", mnq, mnqC, mnqH), alert.freq_all)
    if not na(mym.t) and not na(mym.c) and (na(lastMYM) or mym.t != lastMYM)
        lastMYM := mym.t
        alert(buildMessage("CBOT_MINI:MYM1!", mym, mymC, mymH), alert.freq_all)
    if not na(m2k.t) and not na(m2k.c) and (na(lastM2K) or m2k.t != lastM2K)
        lastM2K := m2k.t
        alert(buildMessage("CME_MINI:M2K1!", m2k, m2kC, m2kH), alert.freq_all)
    if not na(mcl.t) and not na(mcl.c) and (na(lastMCL) or mcl.t != lastMCL)
        lastMCL := mcl.t
        alert(buildMessage("NYMEX:MCL1!", mcl, mclC, mclH), alert.freq_all)
    if not na(mng.t) and not na(mng.c) and (na(lastMNG) or mng.t != lastMNG)
        lastMNG := mng.t
        alert(buildMessage("NYMEX:MNG1!", mng, mngC, mngH), alert.freq_all)
    if not na(mgc.t) and not na(mgc.c) and (na(lastMGC) or mgc.t != lastMGC)
        lastMGC := mgc.t
        alert(buildMessage("COMEX_MINI:MGC1!", mgc, mgcC, mgcH), alert.freq_all)
    if not na(sil.t) and not na(sil.c) and (na(lastSIL) or sil.t != lastSIL)
        lastSIL := sil.t
        alert(buildMessage("COMEX_MINI:SIL1!", sil, silC, silH), alert.freq_all)



// Current-chart technical engine
ema20v = ta.ema(close, 20)
ema50v = ta.ema(close, 50)
ema200v = ta.ema(close, 200)
rsi14v = ta.rsi(close, 14)
atr14v = ta.atr(14)
[macdLineV, macdSignalV, _] = ta.macd(close, 12, 26, 9)
[plusDI, minusDI, adxV] = ta.dmi(14, 14)
volSmaV = ta.sma(volume, 20)
volumeRatioV = not na(volume) and volSmaV > 0 ? volume / volSmaV : 1.0

bbBasis = ta.sma(close, 20)
bbDev = ta.stdev(close, 20) * 2.0
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev

swingHigh = ta.highest(high, structureLen)
swingLow = ta.lowest(low, structureLen)
rangeMid = (swingHigh + swingLow) / 2.0

chartSeconds = timeframe.in_seconds()
higherTf = timeframe.from_seconds(int((na(chartSeconds) ? 900.0 : chartSeconds) * htfMultiplier))
htfEma50 = request.security(syminfo.tickerid, higherTf, ta.ema(close, 50)[1], lookahead=barmerge.lookahead_on)
htfEma200 = request.security(syminfo.tickerid, higherTf, ta.ema(close, 200)[1], lookahead=barmerge.lookahead_on)

// Composite directional score
rawScore = 0.0
rawScore += ema20v >= ema50v ? 1.0 : -1.0
rawScore += ema50v >= ema200v ? 1.0 : -1.0
rawScore += htfEma50 >= htfEma200 ? 2.0 : -2.0
rawScore += rsi14v >= 55 ? 1.0 : rsi14v <= 45 ? -1.0 : 0.0
rawScore += macdLineV >= macdSignalV ? 1.0 : -1.0
rawScore += adxV >= 18 ? (plusDI >= minusDI ? 1.0 : -1.0) : 0.0
rawScore += close >= bbBasis ? 1.0 : -1.0
rawScore += close >= rangeMid ? 1.0 : -1.0
rawScore += volumeRatioV >= 1.0 ? (close >= open ? 1.0 : -1.0) : 0.0

score = rawScore / 10.0
setupDir = score >= setupThreshold ? 1 : score <= -setupThreshold ? -1 : 0

// Candidate calculations
trendAnchor = (ema20v + ema50v) / 2.0

longCenterBase = math.min(close, trendAnchor)
longCenter = math.max(swingLow + atr14v * 0.25, longCenterBase)
longEntryLow = longCenter - atr14v * entryHalfWidthAtr
longEntryHigh = longCenter + atr14v * entryHalfWidthAtr
longStop = math.min(swingLow - atr14v * 0.15, longEntryLow - atr14v * stopAtr)
longEntryMid = (longEntryLow + longEntryHigh) / 2.0
longRisk = math.max(longEntryMid - longStop, atr14v)
longTarget1 = math.max(swingHigh, longEntryMid + longRisk * target1R)
longTarget2 = math.max(longTarget1 + atr14v * 0.25, longEntryMid + longRisk * target2R)

shortCenterBase = math.max(close, trendAnchor)
shortCenter = math.min(swingHigh - atr14v * 0.25, shortCenterBase)
shortEntryLow = shortCenter - atr14v * entryHalfWidthAtr
shortEntryHigh = shortCenter + atr14v * entryHalfWidthAtr
shortStop = math.max(swingHigh + atr14v * 0.15, shortEntryHigh + atr14v * stopAtr)
shortEntryMid = (shortEntryLow + shortEntryHigh) / 2.0
shortRisk = math.max(shortStop - shortEntryMid, atr14v)
shortTarget1 = math.min(swingLow, shortEntryMid - shortRisk * target1R)
shortTarget2 = math.min(shortTarget1 - atr14v * 0.25, shortEntryMid - shortRisk * target2R)

// Stateful technical setup lock
var int lockedDir = 0
var int lockedAtBar = na
var float lockedEntryLow = na
var float lockedEntryHigh = na
var float lockedStop = na
var float lockedTarget1 = na
var float lockedTarget2 = na
var float lockedScore = na

lockedExpired = lockedDir != 0 and not na(lockedAtBar) and (bar_index - lockedAtBar >= setupLifetimeBars)
lockedInvalidated = lockedDir == 1 ? low <= lockedStop : lockedDir == -1 ? high >= lockedStop : false

if barstate.isconfirmed
    if lockedDir != 0 and (lockedExpired or lockedInvalidated)
        lockedDir := 0
        lockedAtBar := na
        lockedEntryLow := na
        lockedEntryHigh := na
        lockedStop := na
        lockedTarget1 := na
        lockedTarget2 := na
        lockedScore := na
    if lockedDir == 0 and setupDir != 0
        lockedDir := setupDir
        lockedAtBar := bar_index
        lockedEntryLow := setupDir == 1 ? longEntryLow : shortEntryLow
        lockedEntryHigh := setupDir == 1 ? longEntryHigh : shortEntryHigh
        lockedStop := setupDir == 1 ? longStop : shortStop
        lockedTarget1 := setupDir == 1 ? longTarget1 : shortTarget1
        lockedTarget2 := setupDir == 1 ? longTarget2 : shortTarget2
        lockedScore := score

entryLow = lockedDir != 0 ? lockedEntryLow : na
entryHigh = lockedDir != 0 ? lockedEntryHigh : na
stopLevel = lockedDir != 0 ? lockedStop : na
target1 = lockedDir != 0 ? lockedTarget1 : na
target2 = lockedDir != 0 ? lockedTarget2 : na

biasColor = lockedDir == 1 ? color.lime : lockedDir == -1 ? color.red : color.gray
entryColor = lockedDir == 1 ? color.aqua : lockedDir == -1 ? color.orange : color.gray

// Visual plots
plot(showEMAs ? ema20v : na, "EMA 20", color=color.aqua, linewidth=2)
plot(showEMAs ? ema50v : na, "EMA 50", color=color.blue, linewidth=2)
plot(showEMAs ? ema200v : na, "EMA 200", color=color.purple, linewidth=2)

plot(showStructure ? swingHigh : na, "Dynamic resistance", color=color.new(color.red, 55), linewidth=1, style=plot.style_linebr)
plot(showStructure ? swingLow : na, "Dynamic support", color=color.new(color.lime, 55), linewidth=1, style=plot.style_linebr)

pEntryLow = plot(showZones ? entryLow : na, "Entry zone low", color=entryColor, linewidth=1, style=plot.style_linebr)
pEntryHigh = plot(showZones ? entryHigh : na, "Entry zone high", color=entryColor, linewidth=1, style=plot.style_linebr)
fill(pEntryLow, pEntryHigh, color=color.new(entryColor, 84), title="Entry zone")

plot(showZones ? stopLevel : na, "Invalidation / Stop", color=color.red, linewidth=2, style=plot.style_linebr)

pTarget1 = plot(showZones ? target1 : na, "Exit zone start / TP1", color=color.green, linewidth=1, style=plot.style_linebr)
pTarget2 = plot(showZones ? target2 : na, "Exit zone end / TP2", color=color.green, linewidth=2, style=plot.style_linebr)
fill(pTarget1, pTarget2, color=color.new(color.green, 86), title="Exit / target zone")

bgcolor(showBiasBackground ? (setupDir == 1 ? color.new(color.green, 94) : setupDir == -1 ? color.new(color.red, 94) : na) : na)

newLong = lockedDir == 1 and lockedDir[1] != 1
newShort = lockedDir == -1 and lockedDir[1] != -1
plotshape(showHistoricalSetupLabels and newLong, title="Historical bullish setup", style=shape.labelup, location=location.belowbar, color=color.lime, text="LONG", textcolor=color.black, size=size.tiny)
plotshape(showHistoricalSetupLabels and newShort, title="Historical bearish setup", style=shape.labeldown, location=location.abovebar, color=color.red, text="SHORT", textcolor=color.white, size=size.tiny)

// One current setup label only. It is refreshed on the last bar so the chart stays readable.
var label currentSetupLabel = na
if barstate.islast
    if not na(currentSetupLabel)
        label.delete(currentSetupLabel)
        currentSetupLabel := na
    if showCurrentSetupLabel and lockedDir != 0
        setupSide = lockedDir == 1 ? "LONG" : "SHORT"
        setupTextLabel = setupSide + "\nENTRY " + str.tostring(entryLow, format.mintick) + " - " + str.tostring(entryHigh, format.mintick) + "\nSL " + str.tostring(stopLevel, format.mintick) + "\nTP1 " + str.tostring(target1, format.mintick) + "\nTP2 " + str.tostring(target2, format.mintick)
        setupY = lockedDir == 1 ? low - atr14v * 0.6 : high + atr14v * 0.6
        currentSetupLabel := label.new(bar_index, setupY, setupTextLabel, style=lockedDir == 1 ? label.style_label_up : label.style_label_down, color=lockedDir == 1 ? color.new(color.green, 0) : color.new(color.red, 0), textcolor=color.white, size=size.small)

// Dashboard
var table dashboard = table.new(position.top_right, 2, 12, border_width=1)

if barstate.islast
    if showDashboard
        setupText = lockedDir == 1 ? "LOCKED LONG" : lockedDir == -1 ? "LOCKED SHORT" : "SCANNING / WAIT"
        liveBiasText = setupDir == 1 ? "BULLISH" : setupDir == -1 ? "BEARISH" : "NEUTRAL"
        displayScore = lockedDir != 0 ? lockedScore : score
        entryText = lockedDir != 0 ? str.tostring(entryLow, format.mintick) + " - " + str.tostring(entryHigh, format.mintick) : "-"
        stopText = lockedDir != 0 ? str.tostring(stopLevel, format.mintick) : "-"
        tp1Text = lockedDir != 0 ? str.tostring(target1, format.mintick) : "-"
        tp2Text = lockedDir != 0 ? str.tostring(target2, format.mintick) : "-"
        table.cell(dashboard, 0, 0, "SETUP", bgcolor=color.new(color.black, 10), text_color=color.white)
        table.cell(dashboard, 1, 0, setupText, bgcolor=color.new(biasColor, 65), text_color=color.white)
        table.cell(dashboard, 0, 1, "ENTRY", text_color=color.white)
        table.cell(dashboard, 1, 1, entryText, text_color=color.white)
        table.cell(dashboard, 0, 2, "STOP", text_color=color.white)
        table.cell(dashboard, 1, 2, stopText, text_color=color.red)
        table.cell(dashboard, 0, 3, "TP1", text_color=color.white)
        table.cell(dashboard, 1, 3, tp1Text, text_color=color.lime)
        table.cell(dashboard, 0, 4, "TP2", text_color=color.white)
        table.cell(dashboard, 1, 4, tp2Text, text_color=color.lime)
        table.cell(dashboard, 0, 5, "LOCKED SCORE", text_color=color.white)
        table.cell(dashboard, 1, 5, str.tostring(math.round(displayScore * 100.0)) + "%", text_color=color.white)
        table.cell(dashboard, 0, 6, "LIVE BIAS", text_color=color.white)
        table.cell(dashboard, 1, 6, liveBiasText, text_color=setupDir == 1 ? color.lime : setupDir == -1 ? color.red : color.silver)
        table.cell(dashboard, 0, 7, "CHART TF", text_color=color.white)
        table.cell(dashboard, 1, 7, timeframe.period, text_color=color.white)
        table.cell(dashboard, 0, 8, "CONFIRM TF", text_color=color.white)
        table.cell(dashboard, 1, 8, higherTf, text_color=color.white)
        table.cell(dashboard, 0, 9, "RSI / ADX", text_color=color.white)
        table.cell(dashboard, 1, 9, str.tostring(rsi14v, "#.0") + " / " + str.tostring(adxV, "#.0"), text_color=color.white)
        table.cell(dashboard, 0, 10, "VOLUME x", text_color=color.white)
        table.cell(dashboard, 1, 10, str.tostring(volumeRatioV, "#.00"), text_color=color.white)
        table.cell(dashboard, 0, 11, "FEED", text_color=color.white)
        table.cell(dashboard, 1, 11, feedEnabled ? "AMP A ON " + feedTf : "AMP A OFF", text_color=color.white)
    else
        table.clear(dashboard, 0, 0, 1, 11)
