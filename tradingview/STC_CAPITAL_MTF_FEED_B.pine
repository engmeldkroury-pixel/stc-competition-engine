//@version=6
indicator("STC Capital MTF Feed B v1.2 Component Shadow", overlay=true)

competitionId = input.string("capital-africa-sep-2026", "Competition ID", options=["capital-africa-sep-2026"], group="Production feed")
feedTf = input.timeframe("15", "Production feed timeframe", options=["15"], group="Production feed")
feedEnabled = input.bool(true, "Enable webhook feed", group="Production feed")

// Exact research-component events are emitted as SHADOW evidence only.
// They have no live gate, risk, approval, or execution authority.
trendiloEvent(int smoothing, int lookback, float almaOffset, float almaSigma, float bandMultiplier) =>
    pch = math.abs(close) > 1e-15 ? (close - close[smoothing]) / close * 100.0 : 0.0
    avpch = ta.alma(pch, lookback, almaOffset, almaSigma)
    rms = bandMultiplier * math.sqrt(ta.sma(avpch * avpch, lookback))
    currentState = not na(avpch) and not na(rms) ? (avpch > rms ? 1 : avpch < -rms ? -1 : 0) : 0
    previousState = nz(currentState[1], 0)
    currentState != 0 and currentState != previousState ? currentState : 0

sslHybridEvent(int baselineLength, int sslLength) =>
    baseline = ta.ema(close, baselineLength)
    highMa = ta.ema(high, sslLength)
    lowMa = ta.ema(low, sslLength)
    int state = 0
    state := not na(baseline) and not na(highMa) and not na(lowMa) ?
         (close > highMa and close > baseline ? 1 :
          close < lowMa and close < baseline ? -1 :
          nz(state[1], 0)) :
         nz(state[1], 0)
    state != 0 and state != nz(state[1], 0) ? state : 0

rangeFilterEvent(int samplingPeriod, float rangeMultiplier) =>
    change = math.abs(close - close[1])
    first = ta.ema(change, samplingPeriod)
    second = ta.ema(first, samplingPeriod * 2 - 1)
    float filt = na
    previousFilter = filt[1]
    if not na(second)
        smoothRange = second * rangeMultiplier
        if na(previousFilter)
            filt := close
        else if close > previousFilter
            filt := math.max(previousFilter, close - smoothRange)
        else if close < previousFilter
            filt := math.min(previousFilter, close + smoothRange)
        else
            filt := previousFilter
    int direction = 0
    previousDirection = nz(direction[1], 0)
    if not na(filt) and not na(previousFilter)
        rising = filt > previousFilter
        falling = filt < previousFilter
        direction := close > filt and rising ? 1 : close < filt and falling ? -1 : previousDirection
    else
        direction := previousDirection
    direction != 0 and direction != previousDirection ? direction : 0

schaffEvent(int cycleLength, int fastLength, int slowLength, float alpha) =>
    fast = ta.ema(close, fastLength)
    slow = ta.ema(close, slowLength)
    macdLine = fast - slow
    lowM = ta.lowest(macdLine, cycleLength)
    highM = ta.highest(macdLine, cycleLength)
    rawK1 = not na(lowM) and not na(highM) ? (highM == lowM ? 0.0 : 100.0 * (macdLine - lowM) / (highM - lowM)) : na
    float d1 = na
    previousD1 = nz(d1[1], rawK1)
    d1 := not na(rawK1) ? previousD1 + alpha * (rawK1 - previousD1) : na
    lowD1 = ta.lowest(d1, cycleLength)
    highD1 = ta.highest(d1, cycleLength)
    rawK2 = not na(lowD1) and not na(highD1) ? (highD1 == lowD1 ? 0.0 : 100.0 * (d1 - lowD1) / (highD1 - lowD1)) : na
    float stc = na
    previousStc = nz(stc[1], rawK2)
    stc := not na(rawK2) ? previousStc + alpha * (rawK2 - previousStc) : na
    now = stc
    previous = stc[1]
    older = stc[2]
    event = 0.0
    if not na(now) and not na(previous) and not na(older)
        event := older >= previous and previous < now and previous <= 25.0 ? 1.0 :
             older <= previous and previous > now and previous >= 75.0 ? -1.0 :
             previous <= 50.0 and now > 50.0 ? 0.65 :
             previous >= 50.0 and now < 50.0 ? -0.65 : 0.0
    event

halfTrendEvent(int amplitude) =>
    highPrice = ta.highest(high, amplitude)
    lowPrice = ta.lowest(low, amplitude)
    highMa = ta.sma(high, amplitude)
    lowMa = ta.sma(low, amplitude)
    var int trend = 0
    var int nextTrend = 0
    var float maxLowPrice = low
    var float minHighPrice = high
    previousTrend = trend
    if bar_index >= amplitude - 1
        if nextTrend == 1
            maxLowPrice := math.max(lowPrice, maxLowPrice)
            if highMa < maxLowPrice and close < low[1]
                trend := 1
                nextTrend := 0
                minHighPrice := highPrice
        else
            minHighPrice := math.min(highPrice, minHighPrice)
            if lowMa > minHighPrice and close > high[1]
                trend := 0
                nextTrend := 1
                maxLowPrice := lowPrice
    trend != previousTrend ? (trend == 0 ? 1.0 : -1.0) : 0.0

componentEvent(string symbol, string component, int intA, int intB, int intC, float floatA, float floatB, float floatC) =>
    request.security(
        symbol,
        feedTf,
        component == "trendilo" ? trendiloEvent(intA, intB, floatA, floatB, floatC) :
        component == "ssl_hybrid" ? sslHybridEvent(intA, intB) :
        component == "range_filter" ? rangeFilterEvent(intA, floatA) :
        component == "schaff" ? schaffEvent(intA, intB, intC, floatA) :
        component == "halftrend" ? halfTrendEvent(intA) : 0.0,
        gaps=barmerge.gaps_off,
        lookahead=barmerge.lookahead_off,
        ignore_invalid_symbol=false
    )


type FeedBar
    int t
    float o
    float h
    float l
    float c
    float v
    float ema20
    float ema50
    float rsi14
    float atr14
    float macd
    float macdSignal
    float volumeRatio
    float familyTrend
    float familyMomentum
    float familyVolatility
    float familyVolume
    float familyVwap
    float familyMarketStructure
    float familySmcLiquidity
    float familyPriceAction
    float familyMicrostructure

type ConfirmBar
    int t
    float c
    float ema20
    float ema50
    float ema200
    float rsi14
    float atr14
    float macd
    float macdSignal
    float volumeRatio

type TrendBar
    int t
    float score

type HistoryBar
    int t
    float c
    float ema50
    float ema200
    float rsi14
    float atr14
    float high252
    float low252
    float momentum20
    float momentum63
    float momentum126
    float momentum252
    float volatility20

clampScore(float x) =>
    math.max(-1.0, math.min(1.0, x))

makeFeedBar() =>
    [macdLine, signalLine, _] = ta.macd(close, 12, 26, 9)
    e20 = ta.ema(close, 20)
    e50 = ta.ema(close, 50)
    e200 = ta.ema(close, 200)
    r = ta.rsi(close, 14)
    a = ta.atr(14)
    stoch = ta.stoch(close, high, low, 14)
    volSma = ta.sma(volume, 20)
    vr = not na(volume) and volSma > 0 ? volume / volSma : 1.0
    safeAtr = math.max(a, syminfo.mintick)
    trendDir = close > e20 and e20 > e50 ? 1.0 : close < e20 and e20 < e50 ? -1.0 : close >= e50 ? 0.30 : -0.30
    familyTrend = clampScore(trendDir * 0.55 + (e50 >= e200 ? 0.25 : -0.25) + (macdLine >= signalLine ? 0.20 : -0.20))
    macdNorm = clampScore((macdLine - signalLine) / math.max(safeAtr * 0.35, syminfo.mintick))
    familyMomentum = clampScore(clampScore((r - 50.0) / 25.0) * 0.40 + clampScore((stoch - 50.0) / 40.0) * 0.25 + macdNorm * 0.35)
    rangeAtr = (high - low) / safeAtr
    volQuality = rangeAtr >= 0.40 and rangeAtr <= 1.80 ? 0.60 : rangeAtr >= 0.20 and rangeAtr <= 2.50 ? 0.20 : rangeAtr > 3.00 ? -0.80 : -0.20
    familyVolatility = clampScore(trendDir * volQuality)
    barDir = close > open ? 1.0 : close < open ? -1.0 : trendDir
    participation = math.max(0.0, math.min(1.0, (vr - 0.70) / 1.00))
    familyVolume = clampScore(barDir * participation)
    vw = ta.vwap(hlc3)
    familyVwap = na(vw) ? 0.0 : clampScore((close - vw) / safeAtr)
    priorHi = ta.highest(high, 20)[1]
    priorLo = ta.lowest(low, 20)[1]
    bos = close > priorHi ? 1.0 : close < priorLo ? -1.0 : 0.0
    familyMarketStructure = clampScore(bos * 0.65 + trendDir * 0.35)
    sweep = high > priorHi and close < priorHi ? -1.0 : low < priorLo and close > priorLo ? 1.0 : 0.0
    fvg = low > high[2] ? 1.0 : high < low[2] ? -1.0 : 0.0
    body = close - open
    displacement = math.abs(body) >= 1.20 * safeAtr ? barDir : 0.0
    familySmcLiquidity = clampScore(sweep * 0.50 + fvg * 0.20 + displacement * 0.30)
    bullEngulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
    bearEngulf = close < open and close[1] > open[1] and open >= close[1] and close <= open[1]
    engulf = bullEngulf ? 1.0 : bearEngulf ? -1.0 : 0.0
    barRange = math.max(high - low, syminfo.mintick)
    clv = ((close - low) - (high - close)) / barRange
    familyPriceAction = clampScore(engulf * 0.55 + clampScore(clv) * 0.45)
    efficiency = math.abs(body) / barRange
    familyMicrostructure = clampScore(barDir * (efficiency * 0.60 + participation * 0.40))
    FeedBar.new(time, open, high, low, close, volume, e20, e50, r, a, macdLine, signalLine, vr, familyTrend, familyMomentum, familyVolatility, familyVolume, familyVwap, familyMarketStructure, familySmcLiquidity, familyPriceAction, familyMicrostructure)

feedBar(string symbol) =>
    request.security(symbol, feedTf, makeFeedBar(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=false)

makeConfirmBar() =>
    [macdLine, signalLine, _] = ta.macd(close, 12, 26, 9)
    volSma = ta.sma(volume, 20)
    ConfirmBar.new(time[1], close[1], ta.ema(close, 20)[1], ta.ema(close, 50)[1], ta.ema(close, 200)[1], ta.rsi(close, 14)[1], ta.atr(14)[1], macdLine[1], signalLine[1], not na(volume[1]) and volSma[1] > 0 ? volume[1] / volSma[1] : 1.0)

confirmBar(string symbol) =>
    request.security(symbol, "60", makeConfirmBar(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on, ignore_invalid_symbol=false)

makeTrendBar() =>
    [macdLine, signalLine, _] = ta.macd(close, 12, 26, 9)
    e20 = ta.ema(close, 20)
    e50 = ta.ema(close, 50)
    e200 = ta.ema(close, 200)
    r = ta.rsi(close, 14)
    volSma = ta.sma(volume, 20)
    vr = not na(volume[1]) and volSma[1] > 0 ? volume[1] / volSma[1] : 1.0
    s = 0.0
    s += close[1] > e20[1] and e20[1] > e50[1] ? 0.30 : close[1] < e20[1] and e20[1] < e50[1] ? -0.30 : 0.0
    s += e50[1] >= e200[1] ? 0.20 : -0.20
    s += macdLine[1] >= signalLine[1] ? 0.20 : -0.20
    s += r[1] >= 52 and r[1] <= 72 ? 0.15 : r[1] <= 48 and r[1] >= 28 ? -0.15 : 0.0
    s += vr >= 1.0 ? (close[1] >= open[1] ? 0.15 : -0.15) : 0.0
    TrendBar.new(time[1], math.max(-1.0, math.min(1.0, s)))

trendBar(string symbol, string tf) =>
    request.security(symbol, tf, makeTrendBar(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on, ignore_invalid_symbol=false)

makeMonthlyTrendBar() =>
    [macdLine, signalLine, _] = ta.macd(close, 6, 13, 5)
    e6 = ta.ema(close, 6)
    e12 = ta.ema(close, 12)
    e24 = ta.ema(close, 24)
    r = ta.rsi(close, 14)
    s = 0.0
    s += close[1] > e6[1] and e6[1] > e12[1] ? 0.35 : close[1] < e6[1] and e6[1] < e12[1] ? -0.35 : 0.0
    s += e12[1] >= e24[1] ? 0.25 : -0.25
    s += macdLine[1] >= signalLine[1] ? 0.20 : -0.20
    s += r[1] >= 52 ? 0.20 : r[1] <= 48 ? -0.20 : 0.0
    TrendBar.new(time[1], math.max(-1.0, math.min(1.0, s)))

monthlyBar(string symbol) =>
    request.security(symbol, "1M", makeMonthlyTrendBar(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on, ignore_invalid_symbol=false)

makeHistoryBar() =>
    m20 = close[21] != 0 ? close[1] / close[21] - 1.0 : 0.0
    m63 = close[64] != 0 ? close[1] / close[64] - 1.0 : 0.0
    m126 = close[127] != 0 ? close[1] / close[127] - 1.0 : 0.0
    m252 = close[253] != 0 ? close[1] / close[253] - 1.0 : 0.0
    vol20 = close[1] != 0 ? ta.atr(20)[1] / close[1] : 0.0
    HistoryBar.new(time[1], close[1], ta.ema(close, 50)[1], ta.ema(close, 200)[1], ta.rsi(close, 14)[1], ta.atr(14)[1], ta.highest(high, 252)[1], ta.lowest(low, 252)[1], m20, m63, m126, m252, vol20)

historyBar(string symbol) =>
    request.security(symbol, "1D", makeHistoryBar(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on, ignore_invalid_symbol=false)

buildMessage(string symbol, FeedBar d, ConfirmBar q, TrendBar t2, TrendBar t4, HistoryBar h, TrendBar m, string communityJson) =>
    communityField = str.length(communityJson) > 0 ? '"community_component_signals":' + communityJson + ',' : ""
    eventId = competitionId + "|" + symbol + "|" + feedTf + "|" + str.tostring(d.t)
    msg = (
        '{"event_id":"' + eventId + '",' +
        '"event":"bar_close",' +
        '"competition_id":"' + competitionId + '",' +
        '"symbol":"' + symbol + '",' +
        '"timeframe":"' + feedTf + '",' +
        '"time":"' + str.format_time(d.t, "yyyy-MM-dd\'T\'HH:mm:ss\'Z\'", "UTC") + '",' +
        '"open":' + str.tostring(d.o) + ',' +
        '"high":' + str.tostring(d.h) + ',' +
        '"low":' + str.tostring(d.l) + ',' +
        '"close":' + str.tostring(d.c) + ',' +
        '"volume":' + str.tostring(d.v) + ',' +
        '"ema20":' + str.tostring(d.ema20) + ',' +
        '"ema50":' + str.tostring(d.ema50) + ',' +
        '"rsi14":' + str.tostring(d.rsi14) + ',' +
        '"atr14":' + str.tostring(d.atr14) + ',' +
        '"macd":' + str.tostring(d.macd) + ',' +
        '"macd_signal":' + str.tostring(d.macdSignal) + ',' +
        '"volume_ratio":' + str.tostring(d.volumeRatio) + ',' +
        '"family_trend":' + str.tostring(d.familyTrend) + ',' +
        '"family_momentum":' + str.tostring(d.familyMomentum) + ',' +
        '"family_volatility":' + str.tostring(d.familyVolatility) + ',' +
        '"family_volume":' + str.tostring(d.familyVolume) + ',' +
        '"family_vwap":' + str.tostring(d.familyVwap) + ',' +
        '"family_market_structure":' + str.tostring(d.familyMarketStructure) + ',' +
        '"family_smc_liquidity":' + str.tostring(d.familySmcLiquidity) + ',' +
        '"family_price_action":' + str.tostring(d.familyPriceAction) + ',' +
        '"family_microstructure":' + str.tostring(d.familyMicrostructure) + ',' +
        communityField +
        '"confirm_timeframe":"60",' +
        '"confirm_time":"' + str.format_time(q.t, "yyyy-MM-dd\'T\'HH:mm:ss\'Z\'", "UTC") + '",' +
        '"confirm_close":' + str.tostring(q.c) + ',' +
        '"confirm_ema20":' + str.tostring(q.ema20) + ',' +
        '"confirm_ema50":' + str.tostring(q.ema50) + ',' +
        '"confirm_ema200":' + str.tostring(q.ema200) + ',' +
        '"confirm_rsi14":' + str.tostring(q.rsi14) + ',' +
        '"confirm_atr14":' + str.tostring(q.atr14) + ',' +
        '"confirm_macd":' + str.tostring(q.macd) + ',' +
        '"confirm_macd_signal":' + str.tostring(q.macdSignal) + ',' +
        '"confirm_volume_ratio":' + str.tostring(q.volumeRatio) + ',' +
        '"trend_2h_time":"' + str.format_time(t2.t, "yyyy-MM-dd\'T\'HH:mm:ss\'Z\'", "UTC") + '",' +
        '"trend_2h_score":' + str.tostring(t2.score) + ',' +
        '"trend_4h_time":"' + str.format_time(t4.t, "yyyy-MM-dd\'T\'HH:mm:ss\'Z\'", "UTC") + '",' +
        '"trend_4h_score":' + str.tostring(t4.score) + ',' +
        '"trend_1m_time":"' + str.format_time(m.t, "yyyy-MM-dd\'T\'HH:mm:ss\'Z\'", "UTC") + '",' +
        '"trend_1m_score":' + str.tostring(m.score) + ',' +
        '"history_timeframe":"1D",' +
        '"history_time":"' + str.format_time(h.t, "yyyy-MM-dd\'T\'HH:mm:ss\'Z\'", "UTC") + '",' +
        '"history_close":' + str.tostring(h.c) + ',' +
        '"history_ema50":' + str.tostring(h.ema50) + ',' +
        '"history_ema200":' + str.tostring(h.ema200) + ',' +
        '"history_rsi14":' + str.tostring(h.rsi14) + ',' +
        '"history_atr14":' + str.tostring(h.atr14) + ',' +
        '"history_high_252":' + str.tostring(h.high252) + ',' +
        '"history_low_252":' + str.tostring(h.low252) + ',' +
        '"history_momentum_20":' + str.tostring(h.momentum20) + ',' +
        '"history_momentum_63":' + str.tostring(h.momentum63) + ',' +
        '"history_momentum_126":' + str.tostring(h.momentum126) + ',' +
        '"history_momentum_252":' + str.tostring(h.momentum252) + ',' +
        '"history_volatility_20":' + str.tostring(h.volatility20) +
        '}'
    )
    msg

zar = feedBar("CAPITALCOM:USDZAR")
zarC = confirmBar("CAPITALCOM:USDZAR")
zar2 = trendBar("CAPITALCOM:USDZAR", "120")
zar4 = trendBar("CAPITALCOM:USDZAR", "240")
zarH = historyBar("CAPITALCOM:USDZAR")
zarM = monthlyBar("CAPITALCOM:USDZAR")
varip int lastZAR = na

xau = feedBar("CAPITALCOM:XAUUSD")
xauC = confirmBar("CAPITALCOM:XAUUSD")
xau2 = trendBar("CAPITALCOM:XAUUSD", "120")
xau4 = trendBar("CAPITALCOM:XAUUSD", "240")
xauH = historyBar("CAPITALCOM:XAUUSD")
xauM = monthlyBar("CAPITALCOM:XAUUSD")
varip int lastXAU = na

xag = feedBar("CAPITALCOM:XAGUSD")
xagC = confirmBar("CAPITALCOM:XAGUSD")
xag2 = trendBar("CAPITALCOM:XAGUSD", "120")
xag4 = trendBar("CAPITALCOM:XAGUSD", "240")
xagH = historyBar("CAPITALCOM:XAGUSD")
xagM = monthlyBar("CAPITALCOM:XAGUSD")
varip int lastXAG = na

spx = feedBar("CAPITALCOM:SPX500")
spxC = confirmBar("CAPITALCOM:SPX500")
spx2 = trendBar("CAPITALCOM:SPX500", "120")
spx4 = trendBar("CAPITALCOM:SPX500", "240")
spxH = historyBar("CAPITALCOM:SPX500")
spxM = monthlyBar("CAPITALCOM:SPX500")
varip int lastSPX = na

nas = feedBar("CAPITALCOM:NAS100")
nasC = confirmBar("CAPITALCOM:NAS100")
nas2 = trendBar("CAPITALCOM:NAS100", "120")
nas4 = trendBar("CAPITALCOM:NAS100", "240")
nasH = historyBar("CAPITALCOM:NAS100")
nasM = monthlyBar("CAPITALCOM:NAS100")
varip int lastNAS = na

nasHalfTrend = componentEvent("CAPITALCOM:NAS100", "halftrend", 5, 0, 0, 0.0, 0.0, 0.0)

zarCommunity = ""
xauCommunity = ""
xagCommunity = ""
spxCommunity = ""
nasCommunity = '{"halftrend_everget":' + str.tostring(nasHalfTrend) + '}'

if feedEnabled and barstate.isconfirmed and barstate.isrealtime
    if not na(zar.t) and not na(zar.c) and not na(zarC.t) and not na(zar2.t) and not na(zar4.t) and not na(zarH.t) and not na(zarM.t) and (na(lastZAR) or zar.t != lastZAR)
        lastZAR := zar.t
        alert(buildMessage("CAPITALCOM:USDZAR", zar, zarC, zar2, zar4, zarH, zarM, zarCommunity), alert.freq_all)
    if not na(xau.t) and not na(xau.c) and not na(xauC.t) and not na(xau2.t) and not na(xau4.t) and not na(xauH.t) and not na(xauM.t) and (na(lastXAU) or xau.t != lastXAU)
        lastXAU := xau.t
        alert(buildMessage("CAPITALCOM:XAUUSD", xau, xauC, xau2, xau4, xauH, xauM, xauCommunity), alert.freq_all)
    if not na(xag.t) and not na(xag.c) and not na(xagC.t) and not na(xag2.t) and not na(xag4.t) and not na(xagH.t) and not na(xagM.t) and (na(lastXAG) or xag.t != lastXAG)
        lastXAG := xag.t
        alert(buildMessage("CAPITALCOM:XAGUSD", xag, xagC, xag2, xag4, xagH, xagM, xagCommunity), alert.freq_all)
    if not na(spx.t) and not na(spx.c) and not na(spxC.t) and not na(spx2.t) and not na(spx4.t) and not na(spxH.t) and not na(spxM.t) and (na(lastSPX) or spx.t != lastSPX)
        lastSPX := spx.t
        alert(buildMessage("CAPITALCOM:SPX500", spx, spxC, spx2, spx4, spxH, spxM, spxCommunity), alert.freq_all)
    if not na(nas.t) and not na(nas.c) and not na(nasC.t) and not na(nas2.t) and not na(nas4.t) and not na(nasH.t) and not na(nasM.t) and (na(lastNAS) or nas.t != lastNAS)
        lastNAS := nas.t
        alert(buildMessage("CAPITALCOM:NAS100", nas, nasC, nas2, nas4, nasH, nasM, nasCommunity), alert.freq_all)

plot(na, title="STC Capital MTF B", display=display.none)
