//@version=6
indicator("STC Competition Feed v0.1", overlay=false)

competitionId = input.string("capital-africa-sep-2026", "Competition ID", options=["capital-africa-sep-2026", "amp-futures-sep-2026"])
feedEnabled = input.bool(true, "Enable webhook feed")

ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
rsi14 = ta.rsi(close, 14)
atr14 = ta.atr(14)
[macdLine, signalLine, _] = ta.macd(close, 12, 26, 9)
volSma = ta.sma(volume, 20)
volumeRatio = volSma > 0 ? volume / volSma : 1.0

seconds = timeframe.in_seconds()
validTf = na(seconds) ? false : seconds >= 60

if feedEnabled and validTf and barstate.isconfirmed
    msg = '{' +
      '"event":"bar_close",' +
      '"competition_id":"' + competitionId + '",' +
      '"symbol":"' + syminfo.prefix + ':' + syminfo.ticker + '",' +
      '"timeframe":"' + timeframe.period + '",' +
      '"time":"' + str.format_time(time, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + '",' +
      '"open":' + str.tostring(open) + ',' +
      '"high":' + str.tostring(high) + ',' +
      '"low":' + str.tostring(low) + ',' +
      '"close":' + str.tostring(close) + ',' +
      '"volume":' + str.tostring(volume) + ',' +
      '"ema20":' + str.tostring(ema20) + ',' +
      '"ema50":' + str.tostring(ema50) + ',' +
      '"rsi14":' + str.tostring(rsi14) + ',' +
      '"atr14":' + str.tostring(atr14) + ',' +
      '"macd":' + str.tostring(macdLine) + ',' +
      '"macd_signal":' + str.tostring(signalLine) + ',' +
      '"volume_ratio":' + str.tostring(volumeRatio) +
      '}'
    alert(msg, alert.freq_once_per_bar_close)

plot(ema20, "EMA20")
plot(ema50, "EMA50")
plot(rsi14, "RSI14", display=display.data_window)
plot(atr14, "ATR14", display=display.data_window)
